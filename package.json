{
  "name": "kya-design",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/next/dist/bin/next dev",
    "build": "prisma generate && node --use-system-ca ./node_modules/next/dist/bin/next build",
    "start": "node --use-system-ca ./node_modules/next/dist/bin/next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "test": "tsx --test src/lib/academy.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.787.0",
    "@prisma/adapter-pg": "6.16.2",
    "@prisma/client": "^6.16.2",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "jose": "^6.1.0",
    "jszip": "^3.10.1",
    "next": "16.3.6",
    "pg": "8.14.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.34.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "8.11.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "png-to-ico": "^3.0.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
