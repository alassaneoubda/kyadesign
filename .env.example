# Échapper chaque $ (\$) : sinon Next tronque le hash bcrypt au démarrage.
ADMIN_PASSWORD_HASH=\$2a\$12\$hash-bcrypt-genere-localement
CV_PASSWORD_HASH=\$2a\$12\$hash-bcrypt-du-mot-de-passe-cv
CV_FILE_NAME="CV_Yohann_Armel_K.pdf"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# E-mails (Resend)
RESEND_API_KEY=""
RESEND_FROM="KYA Design <onboarding@resend.dev>"
CONTACT_TO_EMAIL="koukouiyohannarmel@gmail.com"

# Postgres Supabase — pooler transaction (app)
# sslmode=require requis ; le port 5432 est souvent bloqué en local → utiliser 6543 aussi pour DIRECT_URL
DATABASE_URL="postgresql://postgres.PROJECT_REF:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Optionnel (non requis si Prisma seul)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"

# Cloudflare R2 (albums + images)
