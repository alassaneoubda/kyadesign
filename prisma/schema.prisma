// Kya Design — schéma du contenu piloté par le back-office.
// Auteur : Yohann Armel Koukoui / Kya Design — 2026-09-23 — v1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SiteSetting {
  id              Int     @id @default(1)
  brand           String
  personName      String
  aboutName       String
  aboutRole       String
  footerLine      String
  phone           String
  whatsapp        String
  whatsappDisplay String
  email           String
  /// Dépréciés depuis 2026-09-29 : les réseaux sont gérés dans SocialLink. Conservés pour compatibilité.
  instagram       String
  instagramHandle String
  tiktok          String
  tiktokHandle    String
  behance         String
  behanceHandle   String
  linkedin        String  @default("")
  linkedinHandle  String  @default("")
  aboutIntro      String
  aboutApproach   String
  aboutExperience String
  /// Accroche manuscrite de la section « À propos » (retours à la ligne conservés).
  aboutTagline    String  @default("Créer\ndes visuels\nqui ont du sens")
  heroImage       String
  portraitImage   String
  /// Vrai si le portrait envoyé est détouré (fond transparent) : affichage « sujet devant la forme ».
  portraitCutout  Boolean @default(false)
  logoImage       String
  contactLocation String
  cvFileName      String
}

/// Réseaux sociaux affichés dans « Suivez-nous ».
model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  label     String   @default("")
  handle    String   @default("")
  url       String
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, sortOrder])
}

/// Témoignages clients saisis dans le back-office (jamais générés).
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  company   String   @default("")
  quote     String
  photo     String   @default("")
  visible   Boolean  @default(true)
  /// "admin" (saisi au back-office) ou "visitor" (envoyé depuis le site, masqué jusqu'à validation)
  source    String   @default("admin")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, sortOrder])
  @@index([source, createdAt])
}

/// Audience du site, agrégée par jour (UTC = heure d'Abidjan). Aucune donnée personnelle stockée.
model VisitDay {
  day       DateTime @id @db.Date
  views     Int      @default(0)
  visitors  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Accès au back-office, modifiables depuis /admin/compte (ligne unique id = 1).
/// Tant que la ligne n'existe pas, ADMIN_EMAIL / ADMIN_PASSWORD_HASH servent de repli.
model AdminAccount {
  id           Int      @id @default(1)
  email        String
  passwordHash String
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Fact {
  id        String @id @default(cuid())
  value     String
  label     String
  sortOrder Int
}

model Skill {
  id        String @id @default(cuid())
  label     String
  sortOrder Int
}

model Software {
  id        String @id @default(cuid())
  name      String
  level     Int
  icon      String @default("")
  sortOrder Int
}

model Service {
  id        String @id @default(cuid())
  number    String
  title     String
  text      String
  image     String
  sortOrder Int
}

model Category {
  id        String @id
  label     String
  sortOrder Int
}

model Client {
  id        String @id @default(cuid())
  name      String
  sector    String
  sortOrder Int
}

/// Tous les champs de contenu sont facultatifs : une valeur vide ("") signifie « non renseigné ».
model Project {
  id         String         @id
  title      String         @default("")
  categoryId String         @default("")
  year       String         @default("")
  clientName String         @default("")
  role       String         @default("")
  cover      String         @default("")
  featured   Boolean        @default(false)
  /// Faux = masquée du site public, conservée dans le back-office.
  visible    Boolean        @default(true)
  tags       String         @default("[]")
  probleme   String         @default("")
  concept    String         @default("")
  creation   String         @default("")
  resultat   String         @default("")
  sortOrder  Int            @default(0)
  images     ProjectImage[]

  @@index([visible, sortOrder])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  src       String
  sortOrder Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Formation {
  id        String   @id @default(cuid())
  title     String
  summary   String
  topics    String
  image     String
  published Boolean  @default(true)
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pack {
  id          String   @id @default(cuid())
  title       String
  summary     String
  topics      String
  image       String   @default("")
  highlighted Boolean  @default(false)
  published   Boolean  @default(true)
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TrainingMode {
  id        String @id
  title     String
  lead      String
  detail    String
  includes  String
  image     String
  sortOrder Int
}

model Album {
  id          String       @id @default(cuid())
  title       String
  persons     String       @default("")
  eventDate   String       @default("")
  eventType   String       @default("Cérémonie")
  place       String       @default("")
  description String       @default("")
  accessCode  String       @unique
  maxPhotos   Int          @default(200)
  cover       String       @default("")
  published   Boolean      @default(true)
  kind        String       @default("gallery")
  probleme    String       @default("")
  concept     String       @default("")
  creation    String       @default("")
  resultat    String       @default("")
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  photos      AlbumPhoto[]
}

model ContactRequest {
  id          String   @id @default(cuid())
  name        String
  /// Facultatif : "" quand le visiteur ne donne pas d'e-mail.
  email       String   @default("")
  phone       String   @default("")
  projectType String   @default("")
  budget      String   @default("")
  delay       String   @default("")
  message     String
  emailSent   Boolean  @default(false)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AlbumPhoto {
  id           String @id @default(cuid())
  albumId      String
  originalName String
  ext          String
  bytes        Int
  sortOrder    Int
  album        Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
}
